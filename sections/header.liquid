{%- liquid
  if collections['kurtis'] != blank and collections['kurtis'].products_count > 0
    assign url_kurtis = collections['kurtis'].url
  elsif collections['kurtis-kurtas'] != blank and collections['kurtis-kurtas'].products_count > 0
    assign url_kurtis = collections['kurtis-kurtas'].url
  else
    assign url_kurtis = '/collections/types?q=Kurtis+%26+Kurtas'
  endif

  if collections['co-ord-sets'] != blank and collections['co-ord-sets'].products_count > 0
    assign url_coords = collections['co-ord-sets'].url
  else
    assign url_coords = '/collections/types?q=Co-ord+Sets'
  endif

  if collections['ethnic-sets'] != blank and collections['ethnic-sets'].products_count > 0
    assign url_ethnic = collections['ethnic-sets'].url
  else
    assign url_ethnic = '/collections/types?q=Ethnic+Sets'
  endif

  if collections['dresses'] != blank and collections['dresses'].products_count > 0
    assign url_dresses = collections['dresses'].url
  else
    assign url_dresses = '/collections/types?q=Dresses'
  endif

  if collections['new-in'] != blank and collections['new-in'].products_count > 0
    assign url_new_in = collections['new-in'].url
  else
    assign url_new_in = '/collections/all?sort_by=created-descending'
  endif

  if pages['lookbook'] != blank
    assign url_lookbook = pages['lookbook'].url
  else
    assign url_lookbook = '/#lookbook'
  endif
-%}

<header class="site-header sticky top-0 z-40 bg-[var(--color-bg)]/95 backdrop-blur-md border-b border-[var(--color-border)] transition-all duration-300" id="SiteHeader">
  <div class="site-header__wrapper container mx-auto px-4 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Mobile Hamburger Toggle -->
    <div class="header__left flex items-center gap-4 lg:hidden">
      <button type="button" class="header__icon-btn" id="MobileNavToggle" aria-label="Open navigation menu">
        {% render 'icon-menu' %}
      </button>
      <button type="button" class="header__icon-btn" id="SearchModalToggleMobile" aria-label="Search">
        {% render 'icon-search' %}
      </button>
    </div>

    <!-- Desktop Navigation Left Links -->
    <nav class="hidden lg:flex items-center gap-7 text-xs uppercase tracking-widest font-medium text-[var(--color-text)]">
      {%- if section.settings.use_brand_menu or section.settings.menu.links.size == 0 -%}
        <a href="{{ url_kurtis }}" class="nav-link relative py-2 transition-colors hover:text-[var(--color-accent)]">Kurtis &amp; Kurtas</a>
        <a href="{{ url_coords }}" class="nav-link relative py-2 transition-colors hover:text-[var(--color-accent)]">Co-ord Sets</a>
        <a href="{{ url_ethnic }}" class="nav-link relative py-2 transition-colors hover:text-[var(--color-accent)]">Ethnic Sets</a>
      {%- else -%}
        {%- assign half_count = section.settings.menu.links.size | divided_by: 2 | at_least: 1 -%}
        {%- for link in section.settings.menu.links limit: half_count -%}
          <a href="{{ link.url }}" class="nav-link relative py-2 transition-colors hover:text-[var(--color-accent)] {% if link.active %}active{% endif %}">
            {{ link.title }}
          </a>
        {%- endfor -%}
      {%- endif -%}
    </nav>

    <!-- Brand Logo / Wordmark -->
    <div class="header__center text-center">
      <a href="/" class="site-logo block focus:outline-none">
        {%- if section.settings.logo != blank -%}
          <img 
            src="{{ section.settings.logo | image_url: width: 300 }}" 
            alt="{{ shop.name }}" 
            class="h-8 lg:h-10 w-auto mx-auto object-contain"
            width="160" 
            height="40"
          >
        {%- else -%}
          <span class="site-logo-script block font-['Great_Vibes',cursive] text-2xl lg:text-3xl tracking-wide text-[#C5A059] leading-tight" style="font-family: 'Great Vibes', cursive; background: linear-gradient(135deg, #ead09d, #c5a059, #907030); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            {{ section.settings.brand_name | default: 'ShivShankara' }}
          </span>
          <span class="block w-28 h-[1px] mx-auto my-0.5 bg-gradient-to-r from-transparent via-[#C5A059] to-transparent"></span>
          <span class="block text-[8px] tracking-[0.35em] uppercase text-[#C5A059] font-medium font-sans">
            {{ section.settings.sub_tagline | default: 'CLOTHING • JAIPUR' }}
          </span>
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation Right Links & Actions -->
    <div class="header__right flex items-center justify-end gap-6">
      <nav class="hidden lg:flex items-center gap-7 text-xs uppercase tracking-widest font-medium text-[var(--color-text)] mr-2">
        {%- if section.settings.use_brand_menu or section.settings.menu.links.size == 0 -%}
          <a href="{{ url_dresses }}" class="nav-link relative py-2 transition-colors hover:text-[var(--color-accent)]">Dresses</a>
          <a href="{{ url_new_in }}" class="nav-link relative py-2 transition-colors hover:text-[var(--color-accent)]">New In</a>
          <a href="{{ url_lookbook }}" class="nav-link relative py-2 text-[var(--color-accent)] transition-colors hover:opacity-80">Lookbook</a>
        {%- else -%}
          {%- assign half_count = section.settings.menu.links.size | divided_by: 2 | at_least: 1 -%}
          {%- for link in section.settings.menu.links offset: half_count -%}
            <a href="{{ link.url }}" class="nav-link relative py-2 transition-colors hover:text-[var(--color-accent)] {% if link.active %}active{% endif %}">
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- endif -%}
      </nav>

      <!-- Desktop Search -->
      <button type="button" class="header__icon-btn hidden lg:flex items-center text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors" id="SearchModalToggle" aria-label="Search">
        {% render 'icon-search' %}
      </button>

      <!-- Account (Customer) -->
      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__icon-btn hidden lg:block text-[var(--color-text)] hover:text-[var(--color-accent)]">
          <svg class="icon icon-account" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      {%- endif -%}

      <!-- Cart Trigger with Badge -->
      <button 
        type="button" 
        class="header__cart-trigger flex items-center gap-1.5 text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors relative" 
        id="CartDrawerTrigger" 
        aria-label="View Shopping Bag"
      >
        {% render 'icon-cart' %}
        <span class="cart-count text-xs font-medium font-sans px-1.5 py-0.5 rounded-full bg-[var(--color-btn-bg)] text-[var(--color-btn-text)] leading-none" id="CartCount">
          {{ cart.item_count | default: 0 }}
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-nav-drawer fixed inset-0 bg-black/50 backdrop-blur-sm z-50 lg:hidden opacity-0 pointer-events-none transition-opacity duration-300" id="MobileNavDrawer">
    <div class="mobile-nav-content w-[85%] max-w-sm h-full bg-[var(--color-bg)] flex flex-col justify-between p-6 -translate-x-full transition-transform duration-300 shadow-2xl">
      <div>
        <div class="flex items-center justify-between pb-6 border-b border-[var(--color-border)]">
          <div>
            <span class="font-['Great_Vibes',cursive] text-2xl text-[#C5A059] block" style="font-family: 'Great Vibes', cursive;">ShivShankara</span>
            <span class="block text-[8px] tracking-[0.3em] uppercase text-[#C5A059]">CLOTHING &bull; JAIPUR</span>
          </div>
          <button type="button" class="p-2 -mr-2" id="MobileNavClose" aria-label="Close menu">
            {% render 'icon-close' %}
          </button>
        </div>

        <nav class="flex flex-col gap-4 mt-6 text-sm uppercase tracking-widest font-medium">
          <a href="{{ url_kurtis }}" class="py-2 border-b border-neutral-200/50">Kurtis &amp; Kurtas</a>
          <a href="{{ url_coords }}" class="py-2 border-b border-neutral-200/50">Co-ord Sets</a>
          <a href="{{ url_ethnic }}" class="py-2 border-b border-neutral-200/50">Ethnic Festive Sets</a>
          <a href="{{ url_dresses }}" class="py-2 border-b border-neutral-200/50">Linen &amp; Cotton Dresses</a>
          <a href="{{ url_new_in }}" class="py-2 border-b border-neutral-200/50">New In &bull; Jaipur Drops</a>
          <a href="{{ url_lookbook }}" class="py-2 text-[var(--color-accent)]">#ShivShankara Lookbook</a>
        </nav>
      </div>

      <div class="pt-6 border-t border-[var(--color-border)] flex flex-col gap-3 text-xs text-muted">
        <a href="/pages/about" class="hover:underline">The Jaipur Artisan Story</a>
        <a href="/pages/sizing" class="hover:underline">Concierge Sizing Guide</a>
        <a href="/pages/contact" class="hover:underline">Customer Support Concierge</a>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "ShivShankara"
    },
    {
      "type": "text",
      "id": "sub_tagline",
      "label": "Sub Tagline",
      "default": "CLOTHING • JAIPUR"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "checkbox",
      "id": "use_brand_menu",
      "label": "Use ShivShankara Apparel Menu (Kurtis, Co-ords, Sets, Dresses)",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Custom Menu (Used when checkbox above is off)",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
