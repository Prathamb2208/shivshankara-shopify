<section class="main-collection-section py-10 lg:py-16 bg-[var(--color-bg)]">
  <div class="container mx-auto px-4 lg:px-8">
    
    <!-- Collection Header -->
    <div class="collection-header text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs uppercase tracking-[0.25em] text-muted font-medium block mb-2">Collection</span>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-light tracking-tight mb-4">
        {{ collection.title | default: 'Dresses & Evening Silks' }}
      </h1>
      {%- if collection.description != blank -%}
        <div class="text-xs sm:text-sm text-muted font-light leading-relaxed">
          {{ collection.description }}
        </div>
      {%- else -%}
        <p class="text-xs sm:text-sm text-muted font-light leading-relaxed">
          From bias-cut silk slip dresses to structured cocktail wear, discover silhouettes designed to effortlessly elevate every occasion.
        </p>
      {%- endif -%}
    </div>

    <!-- Filter & Sort Bar -->
    <div class="filter-bar py-4 border-y border-[var(--color-border)] mb-10 flex flex-wrap items-center justify-between gap-4 text-xs">
      <div class="flex items-center gap-6">
        <span class="text-muted tracking-wider uppercase font-medium">
          {{ collection.products_count | default: 8 }} Pieces
        </span>

        <!-- Filter Tags -->
        <div class="hidden sm:flex items-center gap-2">
          <button type="button" class="px-3 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-black transition-colors font-medium">All Silhouettes</button>
          <button type="button" class="px-3 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-black transition-colors">Silk</button>
          <button type="button" class="px-3 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-black transition-colors">Linen</button>
          <button type="button" class="px-3 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-black transition-colors">Wool</button>
        </div>
      </div>

      <div class="flex items-center gap-4 ml-auto">
        <!-- Sort Select -->
        <div class="flex items-center gap-2">
          <label for="SortBy" class="text-muted uppercase tracking-wider text-[11px] font-medium">Sort:</label>
          <select id="SortBy" class="bg-transparent border-none text-xs font-medium focus:outline-none cursor-pointer">
            <option value="manual">Featured</option>
            <option value="price-ascending">Price: Low to High</option>
            <option value="price-descending">Price: High to Low</option>
            <option value="created-descending">Newest Releases</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Products Grid -->
    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10 lg:gap-x-6 lg:gap-y-14">
        {%- if collection.products.size > 0 -%}
          {%- for product in collection.products -%}
            {% render 'product-card', product: product, show_secondary_image: true %}
          {%- endfor -%}
        {%- else -%}
          <!-- Mock preview cards if empty -->
          {%- for i in (1..8) -%}
            <div class="product-card">
              <div class="aspect-[3/4] bg-neutral-200 flex items-center justify-center text-muted text-xs uppercase tracking-wider">
                Piece {{ i }}
              </div>
              <div class="pt-3">
                <h3 class="text-sm font-normal">Aurelia Seasonal Piece {{ i }}</h3>
                <div class="text-xs text-muted mt-1">$210.00</div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="pagination-wrapper text-center pt-16">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
