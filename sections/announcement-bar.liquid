{%- if section.settings.show_announcement -%}
  <div class="announcement-bar py-2 px-4 text-center text-xs tracking-widest uppercase font-medium transition-colors"
       style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="container mx-auto flex items-center justify-between">
      <div class="hidden md:block w-24"></div>
      
      <div class="announcement-messages flex-1 text-center">
        {%- for block in section.blocks -%}
          <div class="announcement-message {% unless forloop.first %}hidden{% endunless %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="hover:underline flex items-center justify-center gap-2">
                <span>{{ block.settings.text }}</span>
                {% if block.settings.show_arrow %}&rarr;{% endif %}
              </a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="hidden md:flex items-center justify-end w-24 gap-3 text-[11px] opacity-80 text-[#C5A059]">
        <span>INR (₹)</span>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#121210"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message Text",
          "default": "Complimentary Delivery on Orders Above ₹1,499 • Handcrafted in Jaipur • Use Code SHIV10 for 10% Off"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Show Arrow",
          "default": false
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}
