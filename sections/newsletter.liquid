<section class="newsletter-section py-20 lg:py-28 bg-[var(--color-surface)] border-t border-[var(--color-border)]">
  <div class="container mx-auto px-4 max-w-2xl text-center">
    {%- if section.settings.subheading != blank -%}
      <span class="text-xs uppercase tracking-[0.3em] text-muted font-medium block mb-3">
        {{ section.settings.subheading }}
      </span>
    {%- endif -%}

    <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-light tracking-tight mb-4">
      {{ section.settings.title }}
    </h2>

    <p class="text-sm lg:text-base text-muted font-light max-w-lg mx-auto mb-8 leading-relaxed">
      {{ section.settings.text }}
    </p>

    {% form 'customer', class: 'newsletter-form max-w-md mx-auto' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="flex flex-col sm:flex-row gap-2">
        <input 
          type="email" 
          name="contact[email]" 
          placeholder="{{ 'general.newsletter.placeholder' | t }}"
          class="flex-1 px-4 py-3.5 bg-[var(--color-bg)] border border-[var(--color-border)] text-xs text-[var(--color-text)] placeholder:text-muted focus:outline-none focus:border-[var(--color-text)]"
          required
        >
        <button 
          type="submit" 
          class="px-8 py-3.5 bg-[var(--color-btn-bg)] text-[var(--color-btn-text)] text-xs uppercase tracking-widest font-medium hover:opacity-90 transition-opacity shrink-0"
        >
          {{ section.settings.button_label | default: 'Join Atelier' }}
        </button>
      </div>

      {%- if form.posted_successfully? -%}
        <p class="mt-4 text-xs text-green-700">
          {{ 'general.newsletter.success' | t }}
        </p>
      {%- endif -%}
    {% endform %}

    <p class="text-[11px] text-muted mt-4">
      By signing up, you agree to receive digital dispatches. Unsubscribe anytime.
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Privileged Access"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Enter the Aurelia Circle"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Enjoy 15% off your inaugural order, priority access to capsule drops, and private salon invites."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
