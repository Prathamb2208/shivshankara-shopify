{%- liquid
  if collections['kurtis'] != blank and collections['kurtis'].products_count > 0
    assign url_kurtis = collections['kurtis'].url
  elsif collections['kurtis-kurtas'] != blank and collections['kurtis-kurtas'].products_count > 0
    assign url_kurtis = collections['kurtis-kurtas'].url
  else
    assign url_kurtis = '/collections/types?q=Kurtis+%26+Kurtas'
  endif

  if collections['co-ord-sets'] != blank and collections['co-ord-sets'].products_count > 0
    assign url_coords = collections['co-ord-sets'].url
  else
    assign url_coords = '/collections/types?q=Co-ord+Sets'
  endif

  if collections['ethnic-sets'] != blank and collections['ethnic-sets'].products_count > 0
    assign url_ethnic = collections['ethnic-sets'].url
  else
    assign url_ethnic = '/collections/types?q=Ethnic+Sets'
  endif

  if collections['dresses'] != blank and collections['dresses'].products_count > 0
    assign url_dresses = collections['dresses'].url
  else
    assign url_dresses = '/collections/types?q=Dresses'
  endif
-%}

<section class="categories-grid-section py-16 lg:py-24 bg-[var(--color-bg)]">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="section-header text-center mb-12">
      {%- if section.settings.subheading != blank -%}
        <span class="text-xs uppercase tracking-[0.25em] text-[#C5A059] font-medium block mb-2">{{ section.settings.subheading }}</span>
      {%- endif -%}
      <h2 class="font-['Outfit',sans-serif] text-3xl lg:text-4xl font-bold tracking-tight text-[var(--color-text)]">{{ section.settings.title }}</h2>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
      {%- for block in section.blocks -%}
        {%- assign target_link = block.settings.link -%}
        {%- if target_link == blank or target_link == '/collections/kurtis' and collections['kurtis'] == blank -%}
          {% case forloop.index0 %}
            {% when 0 %}
              {% assign target_link = url_kurtis %}
            {% when 1 %}
              {% assign target_link = url_coords %}
            {% when 2 %}
              {% assign target_link = url_ethnic %}
            {% when 3 %}
              {% assign target_link = url_dresses %}
            {% else %}
              {% assign target_link = '/collections/all' %}
          {% endcase %}
        {%- elsif target_link == '/collections/co-ord-sets' and collections['co-ord-sets'] == blank -%}
          {% assign target_link = url_coords %}
        {%- elsif target_link == '/collections/ethnic-sets' and collections['ethnic-sets'] == blank -%}
          {% assign target_link = url_ethnic %}
        {%- elsif target_link == '/collections/dresses' and collections['dresses'] == blank -%}
          {% assign target_link = url_dresses %}
        {%- endif -%}

        <div class="category-card group relative aspect-[4/5] overflow-hidden bg-neutral-100 rounded-sm" {{ block.shopify_attributes }}>
          <a href="{{ target_link }}" class="block w-full h-full">
            {%- if block.settings.image != blank -%}
              <img 
                src="{{ block.settings.image | image_url: width: 600 }}" 
                alt="{{ block.settings.title | escape }}"
                class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-108"
                loading="lazy"
                width="600"
                height="750"
              >
            {%- else -%}
              <!-- Default curated placeholder images if merchant hasn't uploaded yet -->
              {% assign img_idx = forloop.index0 | modulo: 4 %}
              <img 
                src="{% case img_idx %}
                  {% when 0 %}https://kjmjeoaipojzyrxshvzo.supabase.co/storage/v1/object/public/product-images/SD1025_KB/SD1025_KB_1.jpg
                  {% when 1 %}https://kjmjeoaipojzyrxshvzo.supabase.co/storage/v1/object/public/product-images/SD836_S/SD836_S_1.jpg
                  {% when 2 %}https://kjmjeoaipojzyrxshvzo.supabase.co/storage/v1/object/public/product-images/SD687_KBD/SD687_KBD_1.jpg
                  {% else %}https://kjmjeoaipojzyrxshvzo.supabase.co/storage/v1/object/public/product-images/SD800_KB/SD800_KB_1.jpg
                {% endcase %}"
                alt="{{ block.settings.title }}"
                class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-108"
                loading="lazy"
                width="600"
                height="750"
              >
            {%- endif -%}

            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent transition-opacity duration-300"></div>

            <div class="absolute inset-x-4 bottom-5 text-center text-white">
              <h3 class="font-['Outfit',sans-serif] text-lg lg:text-xl font-medium tracking-wide mb-1">{{ block.settings.title }}</h3>
              <span class="inline-flex items-center text-[10px] uppercase tracking-[0.2em] font-medium text-[#ead09d] opacity-90 group-hover:opacity-100 transition-opacity">
                Explore Collection &rarr;
              </span>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categories Grid",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated Departments"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Explore by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Kurtas & Kurtis"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories Grid",
      "blocks": [
        {
          "type": "category",
          "settings": { "title": "Kurtas & Kurtis", "link": "/collections/kurtis" }
        },
        {
          "type": "category",
          "settings": { "title": "Co-ord Sets", "link": "/collections/co-ord-sets" }
        },
        {
          "type": "category",
          "settings": { "title": "Ethnic Festive Sets", "link": "/collections/ethnic-sets" }
        },
        {
          "type": "category",
          "settings": { "title": "Linen & Cotton Dresses", "link": "/collections/dresses" }
        }
      ]
    }
  ]
}
{% endschema %}
