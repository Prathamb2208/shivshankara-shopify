<section class="lookbook-section py-16 lg:py-24 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Editorial Story -->
      <div class="lg:col-span-5 flex flex-col justify-center">
        <span class="text-xs uppercase tracking-[0.25em] text-muted font-medium mb-3">
          {{ section.settings.subheading | default: 'Editorial Feature' }}
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-light tracking-tight leading-tight mb-6">
          {{ section.settings.heading | default: 'The Art of Effortless Layering' }}
        </h2>
        <p class="text-sm lg:text-base text-muted font-light leading-relaxed mb-8">
          {{ section.settings.text | default: 'Discover our stylist-curated ensemble. Designed to transition seamlessly from morning atelier appointments to twilight vernissages.' }}
        </p>

        <!-- Hotspot Item List Cards on the side -->
        <div class="hotspot-products-list flex flex-col gap-4">
          {%- for block in section.blocks -%}
            {% assign prod = block.settings.product %}
            <div class="hotspot-item-card flex items-center justify-between p-3.5 bg-[var(--color-bg)] border border-[var(--color-border)] rounded hover:border-[var(--color-text)] transition-colors" data-hotspot-target="{{ forloop.index }}">
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-[var(--color-btn-bg)] text-[var(--color-btn-text)] text-xs flex items-center justify-center font-medium">
                  {{ forloop.index }}
                </span>
                <div>
                  <h4 class="text-xs uppercase tracking-wider font-medium text-[var(--color-text)]">
                    {{ prod.title | default: block.settings.custom_title | default: 'Pure Cashmere Trench' }}
                  </h4>
                  <span class="text-xs text-muted">
                    {{ prod.price | money | default: '$380.00' }}
                  </span>
                </div>
              </div>
              <button 
                type="button" 
                class="text-xs font-medium uppercase tracking-wider underline hover:text-[var(--color-accent)] btn-quick-add"
                data-variant-id="{{ prod.selected_or_first_available_variant.id }}"
              >
                + Add
              </button>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <!-- Right Lookbook Photo with Interactive Pins -->
      <div class="lg:col-span-7 relative">
        <div class="lookbook-image-wrapper relative aspect-[4/5] rounded overflow-hidden shadow-2xl bg-neutral-100">
          {%- if section.settings.image != blank -%}
            <img 
              src="{{ section.settings.image | image_url: width: 1200 }}" 
              alt="{{ section.settings.heading | escape }}"
              class="w-full h-full object-cover object-center"
              loading="lazy"
              width="1000"
              height="1250"
            >
          {%- else -%}
            <img 
              src="https://images.unsplash.com/photo-1509631179647-0177331693ae?q=80&w=1200&auto=format&fit=crop" 
              alt="Shop the Look Editorial"
              class="w-full h-full object-cover object-center"
              loading="lazy"
              width="1000"
              height="1250"
            >
          {%- endif -%}

          <!-- Hotspot Pins -->
          {%- for block in section.blocks -%}
            {% assign prod = block.settings.product %}
            <div 
              class="lookbook-pin absolute -translate-x-1/2 -translate-y-1/2 group cursor-pointer"
              style="left: {{ block.settings.pin_x }}%; top: {{ block.settings.pin_y }}%;"
              data-pin-index="{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              <!-- Pulsing outer ring -->
              <span class="absolute -inset-2 rounded-full bg-white/40 animate-ping"></span>
              <!-- Pin Dot -->
              <span class="relative w-7 h-7 rounded-full bg-white text-black shadow-lg flex items-center justify-center text-xs font-bold border border-black/10 transition-transform group-hover:scale-125">
                {{ forloop.index }}
              </span>

              <!-- Hover Tooltip Preview Card -->
              <div class="lookbook-tooltip absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-52 p-3 bg-white text-black rounded shadow-2xl border border-neutral-200 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-300 z-30">
                <div class="text-[11px] font-semibold text-neutral-900 leading-snug">
                  {{ prod.title | default: block.settings.custom_title | default: 'Featured Fashion Piece' }}
                </div>
                <div class="text-xs text-neutral-600 mt-0.5">
                  {{ prod.price | money | default: '$240.00' }}
                </div>
                <div class="mt-2 pt-2 border-t border-neutral-100">
                  <a href="{{ prod.url | default: '#' }}" class="text-[10px] uppercase tracking-widest font-bold text-neutral-900 hover:underline">
                    View Piece &rarr;
                  </a>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop The Look",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Photo"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop The Look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Art of Effortless Layering"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Discover our stylist-curated ensemble. Designed to transition seamlessly from morning atelier appointments to twilight vernissages."
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Tagged Product"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Display Title (if product not selected)",
          "default": "Virgin Wool Oversized Coat"
        },
        {
          "type": "range",
          "id": "pin_x",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Pin Position X (Horizontal)",
          "default": 45
        },
        {
          "type": "range",
          "id": "pin_y",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Pin Position Y (Vertical)",
          "default": 35
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop The Look",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "custom_title": "Virgin Wool Overcoat",
            "pin_x": 48,
            "pin_y": 32
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "custom_title": "Bias-Cut Silk Slip Dress",
            "pin_x": 52,
            "pin_y": 58
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "custom_title": "Sculpted Nappa Shoulder Bag",
            "pin_x": 35,
            "pin_y": 70
          }
        }
      ]
    }
  ]
}
{% endschema %}
