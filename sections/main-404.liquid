<section class="main-404-section py-20 lg:py-32 bg-[var(--color-bg)] text-center">
  <div class="container mx-auto px-4 max-w-xl">
    <span class="text-xs uppercase tracking-[0.3em] text-[#C5A059] font-semibold block mb-3">404 &bull; Page Not Found</span>
    <h1 class="font-heading text-4xl sm:text-5xl font-bold mb-4 text-[var(--color-text)]">
      {{ section.settings.title | default: 'The Piece You Seek Has Departed' }}
    </h1>
    <p class="text-sm text-muted mb-8 leading-relaxed">
      {{ section.settings.text | default: 'The page, collection, or design you are looking for is no longer here or has moved to our latest catalog.' }}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/" class="w-full sm:w-auto px-8 py-3.5 bg-[#121210] hover:bg-[#C5A059] text-white text-xs uppercase tracking-widest font-semibold rounded-xs transition-colors shadow-md">
        Return to Storefront &rarr;
      </a>
      <a href="/collections/all" class="w-full sm:w-auto px-8 py-3.5 border border-[#121210] text-[#121210] hover:bg-[#121210] hover:text-white text-xs uppercase tracking-widest font-medium rounded-xs transition-colors">
        Explore Collection
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Piece You Seek Has Departed"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "The page, collection, or design you are looking for is no longer here or has moved to our latest catalog."
    }
  ]
}
{% endschema %}
