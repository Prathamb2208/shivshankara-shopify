<section class="main-search-section py-16 lg:py-24 bg-[var(--color-bg)]">
  <div class="container mx-auto px-4 lg:px-8 max-w-4xl text-center">
    <span class="text-xs uppercase tracking-[0.25em] text-[#C5A059] font-semibold block mb-2">ShivShankara Collection Search</span>
    <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-8 text-[var(--color-text)]">
      {%- if search.performed -%}
        Search Results for "{{ search.terms }}"
      {%- else -%}
        Explore Handcrafted Jaipur Apparel
      {%- endif -%}
    </h1>

    <form action="{{ routes.search_url }}" method="get" class="max-w-md mx-auto mb-12">
      <div class="flex items-center border-b-2 border-[#C5A059] pb-2">
        <input 
          type="search" 
          name="q" 
          value="{{ search.terms | escape }}" 
          placeholder="Search kurtis, co-ords, leheriya, anarkali..." 
          class="w-full bg-transparent text-sm focus:outline-none placeholder:text-neutral-400"
        >
        <button type="submit" class="text-xs uppercase tracking-widest font-semibold ml-3 px-4 py-2 bg-[#121210] hover:bg-[#C5A059] text-white transition-colors rounded-xs">
          Search
        </button>
      </div>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-left">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="py-12 bg-white rounded-xs border border-[var(--color-border)] p-8 max-w-lg mx-auto">
          <p class="text-sm text-muted mb-6">No pieces found matching "{{ search.terms }}".</p>
          <a href="/" class="inline-block px-8 py-3.5 bg-[#C5A059] text-white text-xs uppercase tracking-widest font-semibold rounded-xs hover:bg-[#A58039] transition-colors">
            Return to Homepage &rarr;
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
