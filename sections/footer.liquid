{%- liquid
  if collections['kurtis'] != blank and collections['kurtis'].products_count > 0
    assign url_kurtis = collections['kurtis'].url
  elsif collections['kurtis-kurtas'] != blank and collections['kurtis-kurtas'].products_count > 0
    assign url_kurtis = collections['kurtis-kurtas'].url
  else
    assign url_kurtis = '/collections/types?q=Kurtis+%26+Kurtas'
  endif

  if collections['co-ord-sets'] != blank and collections['co-ord-sets'].products_count > 0
    assign url_coords = collections['co-ord-sets'].url
  else
    assign url_coords = '/collections/types?q=Co-ord+Sets'
  endif

  if collections['ethnic-sets'] != blank and collections['ethnic-sets'].products_count > 0
    assign url_ethnic = collections['ethnic-sets'].url
  else
    assign url_ethnic = '/collections/types?q=Ethnic+Sets'
  endif

  if collections['dresses'] != blank and collections['dresses'].products_count > 0
    assign url_dresses = collections['dresses'].url
  else
    assign url_dresses = '/collections/types?q=Dresses'
  endif

  if collections['new-in'] != blank and collections['new-in'].products_count > 0
    assign url_new_in = collections['new-in'].url
  else
    assign url_new_in = '/collections/all?sort_by=created-descending'
  endif

  if pages['lookbook'] != blank
    assign url_lookbook = pages['lookbook'].url
  else
    assign url_lookbook = '/#lookbook'
  endif
-%}

<footer class="site-footer bg-[#121210] text-[#E8E2D9] pt-16 pb-12 border-t border-neutral-800">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-12 pb-16 border-b border-neutral-800/80">
      
      <!-- Brand Column -->
      <div class="lg:col-span-2 flex flex-col justify-between">
        <div>
          <span class="font-script text-3xl text-[#C5A059] block mb-1" style="font-family: 'Great Vibes', cursive;">
            {{ section.settings.brand_title | default: 'ShivShankara' }}
          </span>
          <span class="block text-[8px] tracking-[0.3em] uppercase text-[#C5A059] mb-3">
            {{ section.settings.brand_subtitle | default: 'CLOTHING • JAIPUR' }}
          </span>
          <p class="text-xs text-neutral-400 font-light leading-relaxed max-w-sm mb-6">
            {{ section.settings.brand_bio | default: 'Handcrafted in Jaipur, India. Dedicated to preserving authentic block-printing, pure breathable cottons, and refined contemporary silhouettes.' }}
          </p>
        </div>

        <div class="flex items-center gap-4 text-xs text-neutral-400">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" class="hover:text-[#C5A059] transition-colors" aria-label="Instagram">
              Instagram
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" class="hover:text-[#C5A059] transition-colors" aria-label="Pinterest">
              Pinterest
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" class="hover:text-[#C5A059] transition-colors" aria-label="TikTok">
              TikTok
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Links Column 1: Collections -->
      <div>
        <h4 class="text-xs uppercase tracking-[0.2em] font-medium text-white mb-4">The Collections</h4>
        <ul class="flex flex-col gap-2.5 text-xs text-neutral-400 font-light">
          <li><a href="{{ url_kurtis }}" class="hover:text-[#C5A059] transition-colors">Kurtas &amp; Kurtis</a></li>
          <li><a href="{{ url_coords }}" class="hover:text-[#C5A059] transition-colors">Co-ord Sets</a></li>
          <li><a href="{{ url_ethnic }}" class="hover:text-[#C5A059] transition-colors">Ethnic Festive Sets</a></li>
          <li><a href="{{ url_dresses }}" class="hover:text-[#C5A059] transition-colors">Linen &amp; Cotton Dresses</a></li>
          <li><a href="{{ url_new_in }}" class="hover:text-[#C5A059] transition-colors">New In: Jaipur Drops</a></li>
          <li><a href="{{ url_lookbook }}" class="hover:text-[#C5A059] transition-colors text-[#C5A059]">#ShivShankara Lookbook</a></li>
        </ul>
      </div>

      <!-- Links Column 2: Client Services -->
      <div>
        <h4 class="text-xs uppercase tracking-[0.2em] font-medium text-white mb-4">Patron Care</h4>
        <ul class="flex flex-col gap-2.5 text-xs text-neutral-400 font-light">
          <li><a href="#SizeGuideModal" data-modal-open class="hover:text-[#C5A059] transition-colors cursor-pointer">Concierge Sizing Guide</a></li>
          <li><a href="/pages/shipping-returns" class="hover:text-[#C5A059] transition-colors">Pan-India Express Delivery</a></li>
          <li><a href="/pages/fabric-care" class="hover:text-[#C5A059] transition-colors">Organic Cotton & Dye Care</a></li>
          <li><a href="/pages/order-tracking" class="hover:text-[#C5A059] transition-colors">Track Your Order</a></li>
          <li><a href="/pages/contact" class="hover:text-[#C5A059] transition-colors">Customer Support Concierge</a></li>
        </ul>
      </div>

      <!-- Links Column 3: The Atelier -->
      <div>
        <h4 class="text-xs uppercase tracking-[0.2em] font-medium text-white mb-4">The Jaipur Atelier</h4>
        <p class="text-xs text-neutral-400 leading-relaxed mb-4">
          ShivShankara Clothing<br>
          Jaipur, Rajasthan &bull; 302020<br>
          patron@shivshankara.com
        </p>
        <span class="text-[11px] text-[#C5A059] font-medium block">
          &check; 100% Handcrafted Authenticity Guaranteed
        </span>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] text-neutral-500 font-light">
      <div class="flex items-center gap-6">
        <span>&copy; {{ 'now' | date: '%Y' }} ShivShankara Clothing. All rights reserved.</span>
        <a href="/policies/privacy-policy" class="hover:underline">Privacy Policy</a>
        <a href="/policies/terms-of-service" class="hover:underline">Terms of Service</a>
      </div>

      <!-- Payment Badges / Confidence -->
      <div class="flex items-center gap-3 opacity-80 text-[#C5A059]">
        <span class="text-[10px] tracking-wider uppercase font-medium">Pan-India Free Delivery Above ₹1,499</span>
        <span class="text-[10px]">&bull;</span>
        <span class="text-[10px] font-medium">UPI / NetBanking</span>
        <span class="text-[10px]">&bull;</span>
        <span class="text-[10px] font-medium">Razorpay Secured</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "ShivShankara"
    },
    {
      "type": "text",
      "id": "brand_subtitle",
      "label": "Brand Subtitle",
      "default": "CLOTHING • JAIPUR"
    },
    {
      "type": "textarea",
      "id": "brand_bio",
      "label": "Brand Bio",
      "default": "Handcrafted in Jaipur, India. Dedicated to preserving authentic block-printing, pure breathable cottons, and refined contemporary silhouettes."
    }
  ]
}
{% endschema %}
