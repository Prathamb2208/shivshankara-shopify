<section class="hero-banner relative overflow-hidden bg-neutral-900 text-white min-h-[75vh] lg:min-h-[85vh] flex items-center">
  <!-- Background Image with Overlay -->
  <div class="hero-banner__bg absolute inset-0 z-0">
    {%- if section.settings.image != blank -%}
      <img 
        src="{{ section.settings.image | image_url: width: 2000 }}" 
        alt="{{ section.settings.heading | escape }}"
        class="w-full h-full object-cover object-center scale-105 animate-subtle-zoom"
        loading="eager"
        width="2000"
        height="1200"
      >
    {%- else -%}
      <img 
        src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2070&auto=format&fit=crop" 
        alt="Aurelia Women's Fashion Editorial"
        class="w-full h-full object-cover object-center"
        loading="eager"
        width="2000"
        height="1200"
      >
    {%- endif -%}
    <div class="hero-banner__overlay absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/20" style="opacity: {{ section.settings.overlay_opacity }}%;"></div>
  </div>

  <!-- Hero Content -->
  <div class="container mx-auto px-6 lg:px-12 relative z-10 py-16 lg:py-24 max-w-4xl text-center md:text-left">
    {%- if section.settings.subheading != blank -%}
      <span class="inline-block text-xs uppercase tracking-[0.3em] font-medium mb-4 text-[#C8B9A6] drop-shadow-sm">
        {{ section.settings.subheading }}
      </span>
    {%- endif -%}

    <h1 class="font-serif text-4xl sm:text-5xl lg:text-7xl font-light tracking-tight leading-[1.08] mb-6 drop-shadow-md">
      {{ section.settings.heading }}
    </h1>

    {%- if section.settings.text != blank -%}
      <p class="text-sm sm:text-base lg:text-lg text-neutral-200 font-light max-w-xl mb-8 leading-relaxed">
        {{ section.settings.text }}
      </p>
    {%- endif -%}

    <div class="flex flex-col sm:flex-row items-center gap-4 justify-center md:justify-start">
      {%- if section.settings.button_label_1 != blank -%}
        <a 
          href="{{ section.settings.button_link_1 }}" 
          class="btn-primary w-full sm:w-auto px-8 py-4 bg-white text-black text-xs uppercase tracking-[0.2em] font-medium hover:bg-[#F3EFEA] transition-all duration-300 shadow-xl"
        >
          {{ section.settings.button_label_1 }}
        </a>
      {%- endif -%}

      {%- if section.settings.button_label_2 != blank -%}
        <a 
          href="{{ section.settings.button_link_2 }}" 
          class="btn-secondary w-full sm:w-auto px-8 py-4 border border-white/80 text-white text-xs uppercase tracking-[0.2em] font-medium hover:bg-white/15 transition-all duration-300 backdrop-blur-xs"
        >
          {{ section.settings.button_label_2 }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Opacity",
      "default": 35
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Autumn / Winter 2026 Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Silhouettes Born from Quiet Confidence"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body Text",
      "default": "Sculpted tailoring, fluid silk slip silhouettes, and organic virgin wool coats crafted for the modern muse."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary Button Label",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button Label",
      "default": "View Lookbook"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
