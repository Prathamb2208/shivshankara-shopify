<section class="main-page-section py-12 lg:py-20 bg-[var(--color-bg)]">
  <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
    
    <div class="page-header text-center mb-10">
      <span class="text-xs uppercase tracking-[0.25em] text-[#C5A059] font-semibold block mb-2">ShivShankara &bull; Jaipur</span>
      <h1 class="font-['Outfit',sans-serif] text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-4">
        {{ page.title }}
      </h1>
      <div class="w-16 h-[2px] bg-[#C5A059] mx-auto"></div>
    </div>

    <div class="page-content prose prose-neutral max-w-none text-sm sm:text-base text-[var(--color-text)] leading-relaxed font-light">
      {%- if page.content != blank -%}
        <div class="bg-white p-6 sm:p-10 rounded border border-[var(--color-border)] shadow-xs">
          {{ page.content }}
        </div>
      {%- else -%}
        <div class="bg-white p-8 sm:p-12 rounded border border-[var(--color-border)] text-center shadow-xs">
          <p class="text-muted text-sm mb-6">Welcome to {{ page.title }}. Information for this page is being curated by our Jaipur concierge team.</p>
          <a href="/collections/all" class="inline-block px-6 py-3 bg-[#121210] hover:bg-[#C5A059] text-white text-xs uppercase tracking-widest font-semibold transition-colors">
            Explore Handcrafted Catalog &rarr;
          </a>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
